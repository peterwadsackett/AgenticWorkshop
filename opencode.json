{
  "$schema": "https://opencode.ai/config.json",
  "model": "dtu-gptoss/gptoss",
  "small_model": "dtu-gptoss/gptoss",
  "provider": {
    "dtu-qwen36": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DTU Qwen 3.6",
      "options": {
        "baseURL": "https://teaching.healthtech.dtu.dk/workshop/qwen36"
      },
      "models": {
        "qwen36": {
          "name": "Qwen 3.6 35B-A3B",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    },
    "dtu-qwen38": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DTU Qwen 3.8",
      "options": {
        "baseURL": "https://teaching.healthtech.dtu.dk/workshop/qwen38"
      },
      "models": {
        "qwen38": {
          "name": "Qwen 3.8 27B FP8",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    },
    "dtu-mistral": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DTU Mistral",
      "options": {
        "baseURL": "https://teaching.healthtech.dtu.dk/workshop/mistral"
      },
      "models": {
        "mistral": {
          "name": "Mistral Nemo 12B",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    },
    "dtu-gptoss": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DTU GPT-OSS",
      "options": {
        "baseURL": "https://teaching.healthtech.dtu.dk/workshop/gptoss"
      },
      "models": {
        "gptoss": {
          "name": "GPT-OSS 20B",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask"
  }
}
