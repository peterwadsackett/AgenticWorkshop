          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen38": {
          "name": "Qwen 3.8 27B FP8",
          "provider": {
            "api": "https://teaching.healthtech.dtu.dk/workshop/qwen38"
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "mistral": {
          "name": "Mistral Nemo 12B",
          "provider": {
            "api": "https://teaching.healthtech.dtu.dk/workshop/mistral"
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "gptoss": {
          "name": "GPT-OSS 20B",
          "provider": {
            "api": "https://teaching.healthtech.dtu.dk/workshop/gptoss"
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask"
  }
